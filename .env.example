# Copy to apps/web/.env.local for local development. PLACEHOLDERS ONLY — never commit real values.

# --- Web app (safe for the browser) ---------------------------------------
# Supabase Dashboard → Project Settings → API Keys. Use the *publishable* key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Server-side tools only (NEVER prefix with NEXT_PUBLIC_, never give to bots) ----
# Used by tools/bootstrap-workspace.mjs and, from Phase 2+, the migration tooling and worker.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Tests ------------------------------------------------------------------
# Local throwaway Postgres used by `pnpm test:db` (a fresh database is created and dropped per run).
TEST_DATABASE_ADMIN_URL=postgres://postgres@localhost:54329/postgres

# --- Bots (Phase 4) — server-side only, set in Vercel as regular (non-public) variables ---
# Lets the MCP server and dispatcher call the bot-only database functions.
# SUPABASE_URL and SUPABASE_SECRET_KEY above are reused.
# Shared secret for the scheduled maintenance endpoint (Vercel Cron sends it automatically).
CRON_SECRET=generate-a-long-random-string
# One pair per bot routine; the prefix is the bot's "Routine name" on the Bots page.
# Copy both from the routine's API trigger panel at claude.ai/code/routines.
AFFILIATE_BOT_URL=https://api.anthropic.com/v1/claude_code/routines/trig_xxxxxxxx/fire
AFFILIATE_BOT_TOKEN=placeholder-routine-token
